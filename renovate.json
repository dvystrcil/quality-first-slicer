{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>dvystrcil/renovate-config",
    "docker:pinDigests"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "Group routine patch updates for a smaller review queue",
      "matchUpdateTypes": ["patch"],
      "groupName": "patch updates"
    }
  ]
}
